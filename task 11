# TASK 11: Final Milk Payment Calculator

from decimal import Decimal, ROUND_HALF_UP

# Constants
BASE_RATE = Decimal("30.00")
REFERENCE_FAT = Decimal("3.5")
REFERENCE_SNF = Decimal("8.5")

FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")


# Function to round money
def round_money(value):

    return Decimal(value).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP
    )


# Function to calculate rate
def rate_per_litre(fat, snf):

    fat_steps = (
        (fat - REFERENCE_FAT) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    snf_steps = (
        (snf - REFERENCE_SNF) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE
    )

    return round_money(rate)


# Function to calculate payment
def payout(litres, fat, snf):

    rate = rate_per_litre(fat, snf)

    payment = litres * rate

    return round_money(payment)


# Farmer records
farmers = [
    {
        "farmer_id": "F101",
        "litres": Decimal("10"),
        "fat": Decimal("3.5"),
        "snf": Decimal("8.5"),
        "shift": "morning"
    },

    {
        "farmer_id": "F102",
        "litres": Decimal("8.5"),
        "fat": Decimal("4.2"),
        "snf": Decimal("8.7"),
        "shift": "evening"
    },

    {
        "farmer_id": "F103",
        "litres": Decimal("12"),
        "fat": Decimal("3.1"),
        "snf": Decimal("8.3"),
        "shift": "morning"
    }
]


# Calculate payments
total_payment = Decimal("0.00")

for farmer in farmers:

    payment = payout(
        farmer["litres"],
        farmer["fat"],
        farmer["snf"]
    )

    total_payment += payment

    print("\nFarmer ID:", farmer["farmer_id"])

    print("Shift:", farmer["shift"])

    print("Payment: Rs", payment)


# Display final total
print("\n----- FINAL SUMMARY -----")

print("Number of farmers:", len(farmers))

print("Total payment: Rs", round_money(total_payment))
# TASK 2: Values and Types

from decimal import Decimal

# Checking data types
print(type(10))
print(type(10.0))
print(type("10"))
print(type(True))
print(type([10, 8.5]))

# Arithmetic operators
print("7 / 2 =", 7 / 2)
print("7 // 2 =", 7 // 2)
print("7 % 2 =", 7 % 2)
print("-7 // 2 =", -7 // 2)

# Floating point calculation
print("0.1 + 0.2 =", 0.1 + 0.2)
print("0.1 + 0.2 == 0.3:", 0.1 + 0.2 == 0.3)

# Payments
payments = ["33.40"] * 1000 + ["0.10"] * 3

# Using float
def total_float(items):
    total = 0.0

    for amount in items:
        total += float(amount)

    return total

# Using Decimal
def total_decimal(items):
    total = Decimal("0.00")

    for amount in items:
        total += Decimal(amount)

    return total

print("Float Total:", total_float(payments))
print("Decimal Total:", total_decimal(payments))

print(
    Decimal("0.1") + Decimal("0.2")
    == Decimal("0.3")
)
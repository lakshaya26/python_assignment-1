# TASK 7: Milk Rate Module

from decimal import Decimal, ROUND_HALF_UP

BASE_RATE = Decimal("30.00")
REFERENCE_FAT = Decimal("3.5")
REFERENCE_SNF = Decimal("8.5")

FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")


def round_money(value):
    """Round the amount to two decimal places."""

    return Decimal(value).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP
    )


def rate_per_litre(fat, snf):
    """Calculate the rate per litre."""

    fat_steps = (
        (Decimal(str(fat)) - REFERENCE_FAT) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    snf_steps = (
        (Decimal(str(snf)) - REFERENCE_SNF) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE
    )

    return round_money(rate)


def payout(litres, fat, snf):
    """Calculate payment for the supplied milk."""

    rate = rate_per_litre(fat, snf)

    amount = Decimal(str(litres)) * rate

    return round_money(amount)


if __name__ == "__main__":

    for litres, fat, snf in [
        (10, 3.5, 8.5),
        (8.5, 4.2, 8.7),
        (12, 3.1, 8.3)
    ]:

        rate = rate_per_litre(fat, snf)

        pay = payout(litres, fat, snf)

        print(
            f"{litres:5} L fat {fat} "
            f"snf {snf} rate {rate:6.2f} "
            f"pay {pay:8.2f}"
        )
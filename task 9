# TASK 9: Milk Payment Calculator

from decimal import Decimal, ROUND_HALF_UP

# Constants
BASE_RATE = Decimal("30.00")
REFERENCE_FAT = Decimal("3.5")
REFERENCE_SNF = Decimal("8.5")

FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")

MIN_FAT = Decimal("2.0")
MAX_FAT = Decimal("7.0")

MIN_SNF = Decimal("0.0")
MAX_SNF = Decimal("12.0")


# Function to round money
def round_money(value):
    return Decimal(value).quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP
    )


# Function to calculate rate
def rate_per_litre(fat, snf):

    fat_steps = (
        (fat - REFERENCE_FAT) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    snf_steps = (
        (snf - REFERENCE_SNF) / Decimal("0.1")
    ).quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE
    )

    return round_money(rate)


# Function to calculate payment
def payout(litres, fat, snf):

    rate = rate_per_litre(fat, snf)

    payment = litres * rate

    return round_money(payment)


# Function to validate entry
def validate_entry(farmer_id, litres, fat, snf, shift):

    if farmer_id.strip() == "":
        raise ValueError("Farmer ID cannot be empty")

    if litres <= 0:
        raise ValueError("Litres must be greater than zero")

    if not MIN_FAT <= fat <= MAX_FAT:
        raise ValueError("Fat must be between 2.0 and 7.0")

    if not MIN_SNF <= snf <= MAX_SNF:
        raise ValueError("SNF must be between 0.0 and 12.0")

    if shift not in ["morning", "evening"]:
        raise ValueError("Shift must be morning or evening")


# Main program
def main():

    farmer_id = input("Enter Farmer ID: ")

    try:
        litres = Decimal(input("Enter milk quantity: "))
        fat = Decimal(input("Enter fat percentage: "))
        snf = Decimal(input("Enter SNF percentage: "))

    except Exception:
        print("Please enter valid numeric values")
        return

    shift = input("Enter shift (morning/evening): ").lower()

    try:

        validate_entry(
            farmer_id,
            litres,
            fat,
            snf,
            shift
        )

    except ValueError as error:

        print("Invalid entry:", error)
        return

    rate = rate_per_litre(fat, snf)

    payment = payout(litres, fat, snf)

    print("\n----- PAYMENT RECEIPT -----")

    print("Farmer ID:", farmer_id)

    print("Shift:", shift)

    print("Milk Quantity:", litres)

    print("Fat:", fat)

    print("SNF:", snf)

    print("Rate per litre: Rs", rate)

    print("Total Payment: Rs", payment)


# Run the program
if __name__ == "__main__":
    main()